# ==============================================================================
# NEXUS Platform - Unified Environment Configuration Template
# Copy this file to .env and configure for your environment:
#   cp .env.example .env
#
# IMPORTANT: NEVER commit production credentials or actual API keys to git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Configuration (PostgreSQL 16)
# ------------------------------------------------------------------------------
POSTGRES_DB=nexus_db
POSTGRES_USER=nexus_user
POSTGRES_PASSWORD=nexus_dev_password_change_in_prod
POSTGRES_PORT=5432
# Used by backend when running outside Docker against local/host PostgreSQL:
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/nexus_db

# Connection Pool Tuning
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2

# ------------------------------------------------------------------------------
# 2. Backend Service & Security Configuration
# ------------------------------------------------------------------------------
SERVER_PORT=8080

# Generate a strong 256-bit or 512-bit hex key for production:
# e.g.: openssl rand -hex 32
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000
JWT_COOKIE_NAME=nexus_session

# Set COOKIE_SECURE=true when running behind HTTPS in production
COOKIE_SECURE=false
COOKIE_SAMESITE=Lax

# CORS Origins (comma-separated if multiple)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Rate Limiting Guardrails (protects /api/v1/auth/**)
RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT=30
AUTH_RATE_LIMIT_WINDOW=60

# SSRF Protection (disallow private IP resolutions in production)
ALLOW_PRIVATE_IPS=false

# ------------------------------------------------------------------------------
# 3. AI Intelligence & Provider Configuration
# ------------------------------------------------------------------------------
# Options: 'local' (offline grounded analyzer), 'gemini', 'openai'
AI_PROVIDER=local
AI_MODEL=nexus-grounded-analyzer-v1

# Optional Provider Credentials (leave blank to use offline grounded local analyzer):
# Google Gemini API: https://aistudio.google.com/
# AI_PROVIDER=gemini
# AI_MODEL=gemini-1.5-flash
# AI_API_KEY=your_gemini_api_key_here

# OpenAI API: https://platform.openai.com/
# AI_PROVIDER=openai
# AI_MODEL=gpt-4o-mini
# AI_API_KEY=your_openai_api_key_here

AI_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=3

# ------------------------------------------------------------------------------
# 4. Frontend Web Configuration (Next.js)
# ------------------------------------------------------------------------------
PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# Internal backend URL used by Next.js server rewrites inside Docker
BACKEND_INTERNAL_URL=http://localhost:8080

# ------------------------------------------------------------------------------
# 5. Database Automated Backups
# ------------------------------------------------------------------------------
BACKUP_DIR=./backups
RETENTION_DAYS=7
